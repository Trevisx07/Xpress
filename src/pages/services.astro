---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { site, services } from '@/config/site';
import { icons } from '@/components/icons/map';
import Phone from '@/components/icons/Phone.astro';
import ArrowRight from '@/components/icons/ArrowRight.astro';
import { imageObject } from '@/lib/schema';
import FaqItem from '@/components/FaqItem.astro';
import CtaBand from '@/components/CtaBand.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import Card from '@/components/Card.astro';
import GhostWord from '@/components/GhostWord.astro';
import Eyebrow from '@/components/Eyebrow.astro';

const images = import.meta.glob<ImageMetadata>('/src/assets/*.jpg', { eager: true, import: 'default' });
const imageFor = (file: string) => {
  const img = images[`/src/assets/${file}`];
  if (!img) throw new Error(`services: missing photo src/assets/${file}`);
  return img;
};
const tel = `tel:${site.phone}`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }];

const pricing = [
  { h: 'Hook up fee', p: 'A flat charge to send the truck, load your vehicle, and cover the first stretch of distance.' },
  { h: 'Per mile rate', p: 'Loaded miles beyond the included distance. A tow across Midtown costs less than a run to Fairhope.' },
  { h: 'Extras', p: 'Winching, after hours calls, and waiting time, quoted only when they apply. Nothing is added after the fact.' },
];

const faqs = [
  { q: 'Can you tow an AWD vehicle safely?', a: 'Yes. All wheel drive and four wheel drive vehicles always go on the flatbed so no wheel turns during the tow. Tell the dispatcher the make and model and the right truck is sent.' },
  { q: 'Will you tow a motorcycle?', a: 'Yes. The flatbed carries a wheel chock and soft tie downs, so the bike rides upright with the straps on the frame or bars, never over the tank or seat.' },
  { q: 'What if my car is in a parking garage?', a: 'Give us the garage name and the level. Our light duty truck clears most decks in downtown Mobile and at the medical centers. If the clearance is too low we bring the vehicle to street level with a dolly first.' },
  { q: 'Do you tow to dealerships?', a: 'Yes. We deliver to every dealership on the Airport Blvd and I-65 corridors and beyond, and we can drop after hours with the keys in the night box if the service department allows it.' },
  { q: 'How do I know the price won’t change?', a: 'The dispatcher confirms the full price with you before the truck is dispatched. That figure is what appears on the invoice. If the situation on scene is different from what was described, the driver talks to you before doing anything extra.' },
];

const schema = [
  ...services.map((s) => ({
    '@type': 'Service',
    '@id': `${site.url}/services#${s.slug}`,
    name: s.name,
    serviceType: s.name,
    description: s.short,
    ...(s.image && { image: imageObject(imageFor(s.image), s.imageAlt ?? s.name) }),
    provider: { '@id': `${site.url}/#business` },
    areaServed: site.serviceAreas.map((name) => ({ '@type': 'City', name })),
    url: `${site.url}/services#${s.slug}`,
  })),
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base
  title="Towing Services in Mobile, AL | Xpress Towing & Recovery"
  description="Light and medium duty towing, flatbed transport, accident recovery, lockouts, and jump starts across Mobile, Alabama. Open 24 hours, priced before dispatch."
  canonicalPath="/services"
  ogImage="/og/services.jpg"
  schema={schema}
  breadcrumbs={crumbs}
>
  <section class="dark-tex bg-asphalt" transition:name="hero-services">
    <div class="container-site flex flex-col justify-center py-10 lg:py-14" data-hero-in>
      <Breadcrumbs items={crumbs} />
      <Eyebrow class="mt-6">Services</Eyebrow>
      <h1 class="h1-inner mt-3 max-w-[16ch]">Towing and roadside services in Mobile</h1>
      <p class="mt-6 max-w-[52ch] text-lg text-bone-dim lg:text-xl">Seven things we do well, from a jump start in Midtown to a box truck on I-65. Every job is quoted before the truck rolls.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={tel} class="btn btn-red btn-lg w-full sm:w-auto"><Phone class="size-6" />Call {site.phoneDisplay}</a>
        <a href="/contact" class="btn btn-outline-red btn-lg w-full sm:w-auto">Request a quote</a>
      </div>
    </div>
  </section>

  <SectionDivider variant="slant" direction="right" from="bg-asphalt" to="bg-bone" />

  <section class="wash relative bg-bone text-ink">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true"><GhostWord word="Services" class="text-ink" /></div>
    <div class="container-site relative py-14 lg:py-20">
      <nav aria-label="Jump to a service" class="lg:hidden">
        <ul class="grid grid-cols-2 gap-x-6 border-b border-ink/10 pb-6">
          {services.map((s) => (
            <li><a href={`#${s.slug}`} class="inline-flex min-h-11 items-center gap-2 font-display font-semibold uppercase tracking-wide text-ink hover:text-red-deep"><ArrowRight class="size-4 text-red-deep" />{s.name}</a></li>
          ))}
        </ul>
      </nav>

      <div class="lg:grid lg:grid-cols-12 lg:gap-10 xl:gap-14">
        <nav id="service-nav" aria-label="Services on this page" class="rail-nav hidden lg:block lg:col-span-3" data-draw>
          <ul class="rail" data-rail>
            {services.map((s) => (
              <li><a href={`#${s.slug}`} class="rail-link block origin-left py-2 pl-5 font-display text-[0.95rem] font-semibold uppercase tracking-wide text-ink-soft hover:text-ink aria-[current=true]:font-bold aria-[current=true]:text-ink">{s.name}</a></li>
            ))}
          </ul>
        </nav>
      <div class="articles lg:col-span-9 max-lg:pt-8" data-articles>
        {services.map((s, i) => {
          const Icon = icons[s.icon];
          const img = imageFor(s.image!);
          return (
            <article id={s.slug} class="feature article grid gap-6 lg:grid-cols-12 lg:items-start lg:gap-8 scroll-mt-[calc(var(--header-h)+2rem)]" data-reveal>
              <div class="feature-media border border-ink/10 lg:col-span-5">
                <Picture src={img} alt={s.imageAlt ?? s.name} widths={[640, 960, 1200]} sizes="(min-width: 1024px) 32vw, 92vw" formats={['avif', 'webp']} loading="lazy" class="aspect-[3/2] w-full object-cover" />
              </div>
              <div class="lg:col-span-7">
                <Eyebrow tone="light" size="base">{s.category}</Eyebrow>
                <div class="mt-2 flex items-center gap-3"><Icon class="size-7 shrink-0 text-red-deep" /><h2 class="text-ink">{s.name}</h2></div>
                <div class="mt-3 text-ink-soft">{s.long.map((p) => <p>{p}</p>)}</div>
                <Card variant="dark" class="mt-4 p-4 pt-8">
                  <ul class="grid gap-x-6 gap-y-1.5 text-sm text-bone sm:grid-cols-2">
                    {s.bullets.slice(0, 4).map((b) => <li class="relative pl-5 before:absolute before:left-0 before:top-[0.5em] before:size-2 before:bg-red before:content-['']">{b}</li>)}
                  </ul>
                  <p class="mt-3 border-t border-steel-light pt-3 text-sm text-bone-dim"><span class="font-display text-base font-semibold uppercase tracking-wide text-red-tint">Ideal for:</span> {s.idealFor}</p>
                </Card>
                <a href={tel} class="mt-3 inline-flex min-h-11 items-center gap-2 font-display text-lg font-semibold uppercase tracking-wide text-ink hover:text-red-deep"><Phone class="size-5 text-red-deep" />Call for a {s.name} quote</a>
              </div>
            </article>
          );
        })}
      </div>
      </div>
    </div>
  </section>

  <SectionDivider variant="slant" direction="left" from="bg-bone" to="bg-steel" line />
  <section class="dark-tex bg-steel">
    <div class="container-site py-14 lg:py-20">
      <h2 data-reveal>How pricing works</h2>
      <p class="mt-4 text-lg text-bone-dim">Three parts, all explained on the phone. The total is confirmed with you before dispatch.</p>
      <div class="mt-8 grid gap-5 md:grid-cols-3" data-reveal-stagger>
        {pricing.map((c, i) => (
          <Card variant="dark" class="p-6 pt-10">
            <span class="font-display text-lg font-semibold text-red-tint tabular" aria-hidden="true">0{i + 1}</span>
            <h3 class="mt-1">{c.h}</h3>
            <p class="mt-2 text-sm text-bone-dim">{c.p}</p>
          </Card>
        ))}
      </div>
      <a href={tel} class="btn btn-red mt-8 w-full sm:w-auto"><Phone class="size-5" />Call for an exact quote</a>
    </div>
  </section>

  <SectionDivider variant="slant" direction="right" from="bg-steel" to="bg-bone" />
  <section class="bg-bone text-ink">
    <div class="container-site grid gap-10 py-14 lg:grid-cols-[4fr_8fr] lg:py-20">
      <h2 class="text-ink" data-reveal>Service questions</h2>
      <div data-reveal>{faqs.map((f) => <FaqItem question={f.q}><p>{f.a}</p></FaqItem>)}</div>
    </div>
  </section>

  <CtaBand />

  <script>import '@/scripts/services-nav';</script>
</Base>
