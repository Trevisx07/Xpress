---
import { site, services } from '@/config/site';
import Logo from '@/components/Logo.astro';
import Mail from '@/components/icons/Mail.astro';
const year = new Date().getFullYear();
---
<footer transition:persist class="hazard-edge bg-asphalt border-t border-steel-light text-bone-dim">
  <div class="container-site section-pad !pb-10">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <Logo width={200} loading="lazy" />
        <p class="mt-5 font-display text-xl font-semibold uppercase tracking-wide text-chrome">{site.tagline}</p>
        <p class="mt-3 text-bone-dim">Towing and roadside recovery for Mobile, Alabama and the surrounding Gulf Coast.</p>
        <a href={`tel:${site.phone}`} class="mt-6 inline-block font-display text-3xl font-bold uppercase tracking-tight text-red-tint hover:text-white">{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`} class="mt-3 inline-flex min-h-11 items-center gap-2 break-all text-bone-dim hover:text-bone underline"><Mail class="size-5 shrink-0 text-red-tint" />{site.email}</a>
      </div>

      <div>
        <h2 class="text-base font-semibold tracking-widest text-concrete">Services</h2>
        <ul class="mt-4 space-y-2">
          {services.map((s) => (
            <li><a href={`/services#${s.slug}`} class="link-wipe inline-block py-1 text-bone">{s.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-base font-semibold tracking-widest text-concrete">Service Area</h2>
        <p class="mt-4 text-bone-dim">{site.serviceAreas.join(', ')}, and points within {site.serviceRadiusMiles} miles of downtown Mobile.</p>
      </div>

      <div>
        <h2 class="text-base font-semibold tracking-widest text-concrete">Hours</h2>
        <p class="mt-4 text-bone">{site.hours.open24x7 ? 'Open 24 hours, 7 days a week' : 'Call for hours'}</p>
        <p class="mt-2 text-bone-dim">Licensed and insured in the State of Alabama.</p>
        <ul class="mt-4 space-y-2">
          <li><a href="/commercial-towing" class="link-wipe inline-block py-1 text-bone">Commercial Towing</a></li>
          <li><a href="/contact" class="link-wipe inline-block py-1 text-bone">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="rule-chrome mt-12" aria-hidden="true"></div>
    <div class="flex flex-col gap-2 pt-6 text-sm text-concrete sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.legalName}. {site.address.city}, {site.address.region}.</p>
      <a href="/privacy" class="inline-block py-2 hover:text-bone">Privacy</a>
    </div>
  </div>
</footer>
