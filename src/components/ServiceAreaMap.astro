---
import { site } from '@/config/site';
interface Props { class?: string }
const { class: className } = Astro.props;
---
<figure class={className}>
  <svg viewBox="0 0 400 480" class="w-full h-auto text-bone-dim" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <!-- western shore: Mobile down to Dauphin Island -->
    <path d="M150 20 C140 60 150 90 145 130 C138 170 120 190 128 230 C136 268 118 300 122 340 C126 372 100 396 60 420 C40 434 30 452 44 466" />
    <!-- eastern shore: Spanish Fort down through Fairhope to Fort Morgan -->
    <path d="M250 60 C270 90 262 130 268 170 C272 205 300 225 296 262 C292 300 302 340 318 372 C330 396 350 420 372 440 C384 452 380 464 366 470" />
    <!-- causeway across the head of the bay -->
    <path d="M150 116 L250 108" stroke-dasharray="6 6" />
    <!-- Dauphin Island barrier -->
    <path d="M70 448 L150 452 L230 456" stroke-opacity="0.6" />
    <!-- interstates -->
    <path d="M20 140 L120 130 M120 130 L150 116 M250 108 L300 100 L390 120" stroke-opacity="0.35" />
    <path d="M132 20 L140 130" stroke-opacity="0.35" />
    <!-- service radius -->
    <circle cx="150" cy="118" r="150" stroke="var(--color-red-tint)" stroke-opacity="0.25" stroke-dasharray="4 8" />
    <!-- Mobile -->
    <circle cx="150" cy="118" r="7" fill="var(--color-red-tint)" stroke="none" />
    <circle cx="150" cy="118" r="14" stroke="var(--color-red-tint)" stroke-opacity="0.5" />
    <!-- outlying towns -->
    <g fill="currentColor" stroke="none" fill-opacity="0.7">
      <circle cx="142" cy="80" r="3" /><circle cx="150" cy="40" r="3" /><circle cx="92" cy="150" r="3" /><circle cx="104" cy="182" r="3" /><circle cx="70" cy="110" r="3" />
      <circle cx="262" cy="110" r="3" /><circle cx="268" cy="150" r="3" /><circle cx="280" cy="210" r="3" /><circle cx="40" cy="230" r="3" />
    </g>
  </svg>
  <figcaption class="sr-only">Abstract outline of Mobile Bay with Mobile marked in red and a dashed circle showing the {site.serviceRadiusMiles} mile service radius. Towns served include {site.serviceAreas.join(', ')}.</figcaption>
</figure>
